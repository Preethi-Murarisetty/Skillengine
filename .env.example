# SkillEngine Node backend (users, quiz, coding, master data, assessments).
# Defaults to http://100.124.4.91:3005 if not set.
VITE_BACKEND_URL=http://100.124.4.91:3005

# Only if the "Resume" (PDF exam) and "Performance" pages talk to a separate
# results/PDF service. Defaults to VITE_BACKEND_URL.
# VITE_RESULTS_API_URL=http://100.117.158.50:8000

# Optional fallback: emails treated as admin if the login response has no role.
# (The backend sends role: "admin" | "student", so this is normally not needed.)
# VITE_ADMIN_EMAILS=admin@example.com

# ── Assessment module ────────────────────────────────────────────────────
# Assessment API defaults to ${VITE_BACKEND_URL}/api. Override only if it differs:
# VITE_API_BASE_URL=http://localhost:3005/api

# Self-hosted Judge0 CE (coding questions)
VITE_JUDGE0_URL=http://localhost:2358

# Assessment endpoints. Format: "<METHOD> <path>",
# paths relative to the assessment API base; placeholders {token} {assessmentId} {questionId}.
# Generate-key and verify-key are required for the candidate verification flow.
VITE_EP_GENERATE_KEY=POST /assessment/{token}/generate-key
VITE_EP_VERIFY_KEY=POST /assessment/{token}/verify-key
# VITE_EP_QUESTIONS=GET /assessment/{token}/questions
# VITE_EP_ASSESSMENT_DETAILS=GET /assessment/{token}
# VITE_EP_SAVE_CODING=POST /assessment/{token}/coding-submissions
# VITE_EP_SESSION=GET /assessment/{token}/session
# VITE_EP_RESULT=GET /assessment/{token}/result
