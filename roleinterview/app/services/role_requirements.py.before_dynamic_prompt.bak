SECTION_ALIASES = {

    "summary": {"summary", "professional summary", "objective"},

    "skills": {"skills", "technical skills", "key skills", "core skills"},

    "projects": {"projects", "project", "academic projects"},

    "experience": {

        "experience", "work experience", "internship", "internships",

        "professional experience",

    },

    "education": {"education", "academic background"},

    "certifications": {"certifications", "certificates", "licenses"},

}



ALL_HEADINGS = set().union(*SECTION_ALIASES.values())

ALL_HEADINGS.update({

    "achievements", "languages", "personal details", "declaration",

})





def clean_line(line: str) -> str:

    line = re.sub(r"^[\s•●▪◦*-]+", "", line or "")

    return line.strip()





def heading_name(line: str) -> str:

    """Normalize a standalone section heading."""

    line = clean_line(line).rstrip(":").strip()

    return re.sub(r"\s+", " ", line.casefold())





def _get_section(resume_text: str, wanted: set[str]) -> str:

    """

    Extract a section by matching standalone heading lines.

    Does not confuse bullet content with section headings.

    """

    lines = (resume_text or "").replace("\r\n", "\n").replace("\r", "\n").splitlines()



    wanted = {heading_name(x) for x in wanted}

    inside = False

    result = []



    for raw_line in lines:

        line = raw_line.strip()



        if not line:

            if inside:

                result.append("")

            continue



        heading = heading_name(line)



        if heading in ALL_HEADINGS:

            if inside:

                break

            if heading in wanted:

                inside = True

            continue



        if inside:

            result.append(raw_line)



    return "\n".join(result).strip()





def extract_resume_skill_names(resume_text: str) -> list[str]:

    """Extract individual skill names from the resume Skills section."""

    section = _get_section(resume_text, SECTION_ALIASES["skills"])

    if not section:

        return []



    # Repair PDF line-wrap hyphenation, e.g. "Dashboard De-\nvelopment".

    section = re.sub(r"(?<=\w)-\s*\n\s*(?=\w)", "", section)



    result = []

    seen = set()



    for raw_line in section.splitlines():

        line = clean_line(raw_line)

        if not line:

            continue



        # Strip a category label, but do not treat it as a skill.

        if ":" in line:

            prefix, remainder = line.split(":", 1)

            if len(prefix.split()) <= 6:

                line = remainder.strip()



        line = line.replace("(", ",").replace(")", ",")



        for item in re.split(r"[,;|/\n]", line):

            item = re.sub(r"\s+", " ", item).strip(" .:-\t")

            if not item:

                continue



            key = normalize_skill(item)

            if not key or key in CATEGORY_NAMES:

                continue



            # Ignore obvious category labels even when punctuation differs.

            if key in {

                "data analytics and visualization",

                "data science",

                "database technologies",

                "programming",

                "machine learning",

                "tools",

                "technical skills",

            }:

                continue



            if key not in seen:

                seen.add(key)

                result.append(item)



    return result



def _resume_sections(resume_text: str) -> dict[str, str]:

    return {

        name: _get_section(resume_text, aliases)

        for name, aliases in SECTION_ALIASES.items()

    }





def _line_is_in_section(line: str, section: str) -> bool:

    if not line or not section:

        return False



    target = re.sub(r"\s+", " ", line).strip().casefold()



    return any(

        re.sub(r"\s+", " ", item).strip().casefold() == target

        for item in section.splitlines()

        if item.strip()

    )





def _find_literal_evidence(skill: str, text: str) -> list[str]:

    """Find real lines that explicitly mention the skill phrase."""

    if not skill or not text:

        return []



    phrase = normalize_skill(skill)

    if not phrase:

        return []



    pattern = re.compile(

        r"(?<!\w)" + re.escape(phrase) + r"(?!\w)",

        re.IGNORECASE,

    )



    matches = []

    for line in text.splitlines():

        line = line.strip()

        if line and pattern.search(normalize_skill(line)):

            matches.append(line[:500])



    return list(dict.fromkeys(matches))





def _evidence_chunks(text: str) -> list[str]:

    """Split extracted resume text into short, readable evidence snippets."""

    text = re.sub(r"(?<=\w)-\s*\n\s*(?=\w)", "", text or "")

    chunks = []



    for line in text.splitlines():

        line = line.strip()

        if not line:

            continue



        parts = re.split(r"(?<=[.!?])\s+(?=[A-Z0-9])", line)

        for part in parts:

            part = re.sub(r"\s+", " ", part).strip(" •●▪◦-")

            if part:

                chunks.append(part[:350])



    return list(dict.fromkeys(chunks))





def extract_resume_evidence(

    skill: str,

    resume_text: str,

    ai_evidence: str = "",

    evidence_type: str = "",

) -> dict[str, Any]:

    """Return concise evidence verified against the actual resume."""

    sections = _resume_sections(resume_text)

    listed_skills = extract_resume_skill_names(resume_text)



    skill_evidence = []

    project_evidence = []

    experience_evidence = []



    # Explicitly listed skills count as evidence.

    for listed_skill in listed_skills:

        if skills_match(skill, listed_skill):

            skill_evidence.append(listed_skill)



    # Match skill names and known aliases within short resume sentences.

    section_destinations = (

        ("skills", skill_evidence),

        ("summary", skill_evidence),

        ("certifications", skill_evidence),

        ("projects", project_evidence),

        ("experience", experience_evidence),

    )



    for section_name, destination in section_destinations:

        section_text = sections.get(section_name, "")

        for chunk in _evidence_chunks(section_text):

            if not chunk or len(chunk) > 350:

                continue



            matches = find_resume_skill_evidence(skill, chunk)

            if matches:

                destination.extend(matches)



    # Never treat AI-generated evidence as proof unless it is found

    # in the resume itself. Search the complete resume in short chunks.

    for chunk in _evidence_chunks(resume_text):

        if not chunk or len(chunk) > 350:

            continue



        matches = find_resume_skill_evidence(skill, chunk)

        if not matches:

            continue



        if any(chunk in item for item in _evidence_chunks(

            sections.get("projects", "")

        )):

            project_evidence.extend(matches)

        elif any(chunk in item for item in _evidence_chunks(

            sections.get("experience", "")

        )):

            experience_evidence.extend(matches)

        else:

            skill_evidence.extend(matches)



    skill_evidence = list(dict.fromkeys(

        item.strip()[:350] for item in skill_evidence if item.strip()

    ))

    project_evidence = list(dict.fromkeys(

        item.strip()[:350] for item in project_evidence if item.strip()

    ))

    experience_evidence = list(dict.fromkeys(

        item.strip()[:350] for item in experience_evidence if item.strip()

    ))



    supported = bool(

        skill_evidence or project_evidence or experience_evidence

    )



    return {

        "resume_skill_evidence": skill_evidence[:5],

        "resume_project_evidence": project_evidence[:5],

        "resume_experience_evidence": experience_evidence[:5],

        "resume_supported": supported,

    }



def call_ollama(prompt: str) -> str:

    response = requests.post(

        OLLAMA_URL,

        json={

            "model": OLLAMA_MODEL,

            "prompt": prompt,

            "stream": False,

            "format": "json",

            "options": {"temperature": 0.1},

        },

        timeout=180,

    )

    response.raise_for_status()

    return str(response.json().get("response", "")).strip()





def parse_json_response(raw: str) -> dict[str, Any]:

    raw = (raw or "").strip()



    try:

        parsed = json.loads(raw)

        if isinstance(parsed, dict):

            return parsed

    except json.JSONDecodeError:

        pass



    start = raw.find("{")

    end = raw.rfind("}")



    if start >= 0 and end > start:

        try:

            parsed = json.loads(raw[start:end + 1])

            if isinstance(parsed, dict):

                return parsed

        except json.JSONDecodeError:

            pass



    return {}





def normalize_concepts(concepts: Any) -> list[dict[str, Any]]:

    result = []

    seen = set()



    if not isinstance(concepts, list):

        return result



    for item in concepts:

        if isinstance(item, str):

            name = item.strip()

        elif isinstance(item, dict):

            name = str(

                item.get("name")

                or item.get("concept")

                or item.get("title")

                or ""

            ).strip()

        else:

            continue



        key = name.casefold()

        if name and key not in seen:

            seen.add(key)

            result.append({

                "name": name,

                "difficulty": DIFFICULTIES.copy(),

            })



    return result





def generate_concepts(skill: str, role: str) -> list[dict[str, Any]]:

    prompt = f"""

Return only valid JSON:

{{

  "concepts": [

    {{"name": "Concept name"}}

  ]

}}



Create 4 to 8 distinct interview concepts for the skill "{skill}"

relevant to the target role "{role}".



Rules:

- Only return concept names.

- Do not generate interview questions.

- Do not claim the candidate knows these concepts.

- Keep concepts specific to the skill and role.

"""

    try:

        data = parse_json_response(call_ollama(prompt))

        concepts = normalize_concepts(data.get("concepts", []))

        if concepts:

            return concepts

    except Exception as exc:

        print(f"WARNING: Concept generation failed for {skill}: {exc}")



    return [{"name": skill, "difficulty": DIFFICULTIES.copy()}]





def build_role_prompt(role: str, resume_text: str) -> str:

    return f"""

Return only valid JSON without markdown.



Analyze the candidate's resume for the target role "{role}".



Use this schema:

{{

  "role_required_skills": ["skill name"],

  "skill_areas": [

    {{

      "skill": "skill name",

      "resume_evidence": "exact short quote from resume or empty string",

      "concepts": [

        {{"name": "concept name"}}

      ]

    }}

  ]

}}



Rules:

- Return 5 to 10 relevant skills required for the target role.

- Include relevant skills even when they are absent from the resume.

- Never claim a skill is supported without actual resume evidence.

- resume_evidence must be copied exactly from the resume.

- Do not generate interview questions.

- Include distinct concepts for each skill.



RESUME:

{(resume_text or "")[:9000]}

"""





def generate_role_requirements(

    role: str,

    resume_text: str,

) -> dict[str, Any]:

    """Build role requirements, verify resume evidence, and validate concepts."""

    resume_text = resume_text or ""

    resume_skills = extract_resume_skill_names(resume_text)



    role_key = normalize_skill(role)

    raw_required = []

    ai_areas = []



    # Prefer configured role profiles for consistent, role-specific results.

    # Match exact normalized role names; do not use resume skills as a fallback.

    profile_key = role_key

    if profile_key not in ROLE_SKILLS:

        profile_key = None



    if profile_key:

        required_skills = ROLE_SKILLS[profile_key].copy()

    else:

        try:

            data = parse_json_response(

                call_ollama(build_role_prompt(role, resume_text))

            )

            raw_required = data.get("role_required_skills", [])

            ai_areas = data.get("skill_areas", [])

        except Exception as exc:

            raise RuntimeError(

                f"Could not generate role requirements for '{role}'. "

                "Please retry or add a role profile to ROLE_SKILLS."

            ) from exc



        if not isinstance(raw_required, list):

            raw_required = []

        if not isinstance(ai_areas, list):

            ai_areas = []



        required_skills = []

        for item in raw_required:

            if not isinstance(item, str):

                continue

            skill = item.strip()

            if not skill or normalize_skill(skill) in CATEGORY_NAMES:

                continue

            if not any(

                skills_match(skill, existing)

                for existing in required_skills

            ):

                required_skills.append(skill)



        if not required_skills:
            print("DEBUG role:", repr(role))
            print("DEBUG raw_required:", repr(raw_required))
            print("DEBUG ai_areas:", repr(ai_areas))
            print("DEBUG required_skills after filtering:", repr(required_skills))

            raise RuntimeError(

                f"No valid role-specific requirements were generated for "

                f"'{role}'. Please retry or add a role profile to ROLE_SKILLS."

            )



    # Create one area per role requirement. Do not add every resume skill

    # as an interview topic for a role that does not require it.

    ai_area_by_skill = {}

    for item in ai_areas:

        if isinstance(item, str):

            item = {"skill": item}

        if not isinstance(item, dict):

            continue



        name = str(item.get("skill") or item.get("name") or "").strip()

        if name and normalize_skill(name) not in CATEGORY_NAMES:

            ai_area_by_skill[normalize_skill(name)] = item



    areas = []

    common_skills = []

    missing_role_skills = []



    for skill in required_skills:

        ai_item = ai_area_by_skill.get(normalize_skill(skill), {})

        evidence = extract_resume_evidence(

            skill=skill,

            resume_text=resume_text,

        )



        supported = evidence["resume_supported"]

        if supported:

            common_skills.append(skill)

        else:

            missing_role_skills.append(skill)



        # Use a trusted concept map when available; ignore potentially

        # unrelated AI concepts for these well-known skills.

        trusted_key = normalize_skill(skill)

        concepts_list = TRUSTED_CONCEPTS.get(trusted_key)



        if concepts_list is None:

            ai_concepts = normalize_concepts(ai_item.get("concepts", []))

            concepts_list = [item["name"] for item in ai_concepts]



        if not concepts_list:

            concepts_list = [skill]



        concepts = [

            {"name": name, "difficulty": DIFFICULTIES.copy()}

            for name in concepts_list

        ]



        all_evidence = (

            evidence["resume_skill_evidence"]

            + evidence["resume_project_evidence"]

            + evidence["resume_experience_evidence"]

        )



        areas.append({

            "skill": skill,

            "resume_evidence": all_evidence[0] if all_evidence else None,

            "concepts": concepts,

            "resume_skill_evidence": evidence["resume_skill_evidence"],

            "resume_project_evidence": evidence["resume_project_evidence"],

            "resume_experience_evidence": evidence["resume_experience_evidence"],

            "resume_supported": supported,

        })



    resume_only_skills = [

        skill for skill in resume_skills

        if not any(skills_match(skill, required) for required in required_skills)

    ]



    print("DEBUG resume_skills:", resume_skills)

    print("DEBUG role_required_skills:", required_skills)

    print("DEBUG common_skills:", common_skills)

    print("DEBUG missing_role_skills:", missing_role_skills)



    return {

        "role": role,

        "resume_skills": resume_skills,

        "role_required_skills": required_skills,

        "common_skills": common_skills,

        "resume_only_skills": resume_only_skills,

        "missing_role_skills": missing_role_skills,

        "skill_areas": areas,

        "note": (

            "Resume-supported skills require evidence found in the resume. "

            "Each listed concept has Easy, Medium, and Hard difficulty levels."

        ),

    }

