# Copy to .env (never commit .env). Restart `npm run dev` after changes.
VITE_BACKEND_URL=              # legacy Node API (users, quiz, coding, assessments)
VITE_AI_API_URL=               # optional AI service proxied at /ai-backend
VITE_RESUME_API_URL=http://127.0.0.1:8000   # FastAPI service (roleinterview/)
ROLEINTERVIEW_PORT=8000        # must match the port uvicorn actually uses
VITE_CORE_API_ENABLED=false    # true only after the core backend is fully configured
VITE_ADMIN_EMAILS=             # comma-separated admin emails if the API sends no role
# VITE_JUDGE0_URL, VITE_RESULTS_API_URL, VITE_CORE_API_BASE_URL, VITE_EP_* are optional overrides.
